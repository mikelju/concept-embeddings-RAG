# Environment and secrets
.env
.env.*
!.env.example

# Temporary files
.tmp/
*.pyc
__pycache__/

# Credentials
credentials.json
token.json

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Node (if applicable)
node_modules/
dist/

# Python (if applicable)
venv/
.venv/
*.egg-info/

# Downloaded corpus and regenerable experiment artifacts stay out; measured
# results and the manifest that gives them provenance are the deliverable and
# are versioned. So is the Phase 3 selection: HU-3 asks for the choice of K to
# live in a versioned artifact, and a decision recorded in an ignored file is
# exactly the one the repository cannot reproduce.
data/*
!data/.gitkeep
!data/manifest.json
!data/results/
data/results/*
!data/results/*.json
!data/selection/
data/selection/*
!data/selection/*.json
# The Phase 4 freeze, by the same rule as Phase 3's: every number of that phase is
# bound to it, so a checkout that cannot verify the digest cannot check the results.
!data/expansion/
data/expansion/*
!data/expansion/*.json
# The traces are diagnostics, not a freeze: 0.7 MB per arm of per-round detail that
# `cer expand` regenerates deterministically from the artifacts above. The reading
# that matters is quoted in 4.results.md.
data/traces/
.cache/
models/
output/
*.npy
*.npz

# Python tooling
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Saved-webpage asset folders (js/css/images), not worth versioning
*_files/

# Reference material that is not part of the experiment: official PDFs and saved
# articles by third parties. Kept locally, never published.
docs/bases legales/

# Personal reading aid, in Spanish, for the Phase 3 vocabulary. The project
# documents in English by convention; this file is a deliberate local exception
# and is not part of the deliverable.
docs/GLOSARIO.md

# Agent-interop mirror generated by external tooling on 2026-09-09: `.agents/`
# duplicates `.claude/skills/` (105 MB, including a Playwright virtualenv) and
# `AGENTS.md` is `CLAUDE.md` with `.claude/` rewritten to a `.Codex/` path that
# does not exist here. `.claude/` is the tracked copy; these are not.
.agents/
AGENTS.md
